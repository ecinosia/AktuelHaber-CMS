# Which brand's BE this CMS instance manages
NEXT_PUBLIC_BRAND_ID=aktuelhaber

# AktuelHaber-BE INTERNAL address (e.g. http://127.0.0.1:4001). Never sent to browsers: the CMS proxies /api/* to it,
# so the BE does not have to be publicly reachable. Read at build time.
API_BASE_URL=http://localhost:4000

# AktuelHaber-FE base URL for this brand's public site — used for the "Canlıda
# Gör" (view live) links on Article/Column/Category/Author list & edit pages.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

PORT=3001

# Must match AktuelHaber-BE's SESSION_COOKIE_NAME — the dashboard layout
# forwards this cookie server-side when checking /auth/me.
SESSION_COOKIE_NAME=ah_session

# Public base URL of the media bucket (same as BE STORAGE_PUBLIC_URL) — lets the rich-text editor
# re-ingest images pasted from another article so no image is shared between two entities.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=https://storage.customerdomain.com/aktuelhaber
